<% content_for :title, "Modifier la facture · Tresora" %>

<section class="page-header page-header--compact">
  <div>
    <p class="eyebrow">Facturation</p>
    <h1>Modifier <%= @invoice.number %></h1>
  </div>
  <%= link_to "Retour à la facture", invoice_path(@invoice), class: "button button--secondary" %>
</section>

<section class="card form-card form-card--wide">
  <%= render "form", invoice: @invoice %>
</section>
