<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || "Tresora" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Tresora">
    <meta name="description" content="Un cockpit simple pour suivre ses factures et sa trésorerie.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <div class="container topbar__inner">
        <%= link_to root_path, class: "brand", aria: { label: "Tresora, accueil" } do %>
          <span class="brand__mark">T</span>
          <span class="brand__name">tresora</span>
        <% end %>

        <nav class="main-nav" aria-label="Navigation principale">
          <%= link_to "Tableau de bord", root_path, class: "main-nav__link" %>
          <%= link_to "Factures", invoices_path, class: "main-nav__link" %>
          <%= link_to "Clients", clients_path, class: "main-nav__link" %>
        </nav>

        <div class="topbar__account">
          <span class="topbar__status"><span class="status-dot"></span> Démo</span>
        </div>
      </div>
    </header>

    <main class="container main-content">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <span>Tresora · MVP Rails</span>
        <span>Des données simples pour des décisions plus claires.</span>
      </div>
    </footer>
  </body>
</html>
